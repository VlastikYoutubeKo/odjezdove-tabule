<Project Sdk="Microsoft.NET.Sdk">
  <!-- Samostatný program, který se připojí k běžícímu OMSI (stejná logika jako plugin). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <Platforms>x86</Platforms>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>OmsiTabule</AssemblyName>
    <RootNamespace>OmsiTabule</RootNamespace>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RollForward>LatestMajor</RollForward>
    <!-- při releasu přepíše workflow: -p:Version=X.Y.Z -->
    <Version>0.0.0-dev</Version>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Core/*.cs" />
    <PackageReference Include="OmsiHook" Version="2.5.3" />
    <None Include="../OmsiTabule.ini" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
